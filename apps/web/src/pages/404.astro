---
import Icone from '../components/shell/Icone.astro';
import Ferramenta from '../layouts/Ferramenta.astro';
import { caminhoDa, FERRAMENTAS_ATIVAS } from '../lib/registry';

// Um punhado de atalhos, não o catálogo inteiro: a lista completa está a um
// clique no rail, e quem caiu aqui quer sair daqui, não escolher entre treze
// opções. A fonte continua sendo o registry, então a página não envelhece.
const sugestoes = FERRAMENTAS_ATIVAS.slice(0, 6);
---

<Ferramenta
  titulo="Página não encontrada"
  descricao="O endereço não existe mais ou nunca existiu. As ferramentas continuam todas aqui."
  caminho="/404"
>
  <h1 class="titulo">404</h1>
  <p class="subtitulo">
    Esse endereço não existe. Se você veio de um link curto, ele mora em <code>link.minime.cloud</code
    > — confira se o endereço está completo.
  </p>

  <h2 class="rotulo">Ir para</h2>
  <ul class="atalhos">
    {
      sugestoes.map((item) => (
        <li>
          <a class="atalho" href={caminhoDa(item)}>
            <Icone slug={item.slug} />
            {item.nome}
          </a>
        </li>
      ))
    }
  </ul>
</Ferramenta>

<style>
  .titulo {
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    margin: 0 0 0.75rem;
  }

  .subtitulo {
    margin: 0 0 2rem;
    color: var(--texto-fraco);
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 52ch;
  }

  .subtitulo code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    color: var(--texto);
  }

  .atalhos {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .atalho {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.4375rem 0.75rem;
    border: 1px solid var(--borda);
    border-radius: var(--radius-campo);
    background-color: var(--superficie-alta);
    color: var(--texto);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .atalho:hover {
    border-color: var(--acento);
  }

  .atalho:hover :global(.icone) {
    opacity: 1;
    color: var(--acento);
  }
</style>
