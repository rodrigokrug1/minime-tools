---
/**
 * Título e subtítulo padrão de uma página de ferramenta. Existe para que as
 * dez páginas não repitam o mesmo bloco e não divirjam com o tempo.
 */
type Props = {
  titulo: string;
  descricao: string;
};

const { titulo, descricao } = Astro.props;
---

<h1 class="titulo">{titulo}</h1>
<p class="subtitulo">{descricao}</p>

<style>
  .titulo {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 4vw, 1.625rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    margin: 0 0 0.25rem;
  }

  .subtitulo {
    margin: 0 0 1.5rem;
    color: var(--texto-fraco);
    font-size: 0.9375rem;
    max-width: 52ch;
  }
</style>
