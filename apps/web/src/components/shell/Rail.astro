---
import { agruparPorCategoria, caminhoDa, ROTULO_CATEGORIA } from '../../lib/registry';
import Icone from './Icone.astro';

const atual = Astro.url.pathname;
const grupos = agruparPorCategoria();
---

<nav class="rail" aria-label="Ferramentas">
  <div class="rail-conteudo">
    {
      grupos.map((grupo) => (
        <section class="rail-grupo">
          <h2 class="rotulo rail-titulo">{ROTULO_CATEGORIA[grupo.categoria]}</h2>
          <ul class="rail-lista">
            {grupo.itens.map((ferramenta) => {
              const href = caminhoDa(ferramenta);
              const ativa = atual === href || atual === `${href}/`;

              return (
                <li>
                  {ferramenta.status === 'ativo' ? (
                    <a href={href} class="rail-item" aria-current={ativa ? 'page' : undefined}>
                      <Icone slug={ferramenta.slug} />
                      <span class="rail-nome">{ferramenta.nome}</span>
                    </a>
                  ) : (
                    <span class="rail-item rail-item-inativo" aria-disabled="true">
                      <Icone slug={ferramenta.slug} />
                      <span class="rail-nome">{ferramenta.nome}</span>
                      <span class="rail-tag">em breve</span>
                    </span>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
</nav>

<style>
  .rail {
    border-right: 1px solid var(--borda);
    background-color: var(--superficie);
  }

  .rail-conteudo {
    padding: 1.25rem 0.75rem 2rem;
  }

  .rail-grupo + .rail-grupo {
    margin-top: 1.5rem;
  }

  .rail-titulo {
    padding: 0 0.5rem;
    margin-bottom: 0.375rem;
  }

  .rail-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .rail-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4375rem 0.5rem;
    border-radius: var(--radius-campo);
    font-size: 0.8125rem;
    color: var(--texto);
    text-decoration: none;
    line-height: 1.2;
  }

  .rail-nome {
    flex: 1 1 auto;
    min-width: 0;
  }

  a.rail-item:hover {
    background-color: var(--superficie-alta);
  }

  a.rail-item:hover :global(.icone) {
    opacity: 1;
  }

  a.rail-item[aria-current='page'] {
    background-color: var(--superficie-alta);
    box-shadow: inset 2px 0 0 var(--acento);
    color: var(--acento);
  }

  a.rail-item[aria-current='page'] :global(.icone) {
    opacity: 1;
  }

  .rail-item-inativo {
    color: var(--texto-fraco);
    cursor: default;
  }

  .rail-item-inativo :global(.icone) {
    opacity: 0.4;
  }

  .rail-tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--texto-fraco);
    border: 1px solid var(--borda);
    border-radius: 999px;
    padding: 0 0.375rem;
    white-space: nowrap;
  }
</style>
